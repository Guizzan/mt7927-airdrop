+/* Local patch: TLV 17 wraps standard 802.11 elements. A Mac puts its VHT
+ * Capabilities element here, and without one it treats us as HT only. These
+ * are a 2x2 Mac's bytes: max MPDU 11454, RX LDPC, SGI 80, MCS 0-9 on 2 streams. */
+int awdl_init_vht_container_tlv(uint8_t *buf, const struct awdl_state *state __attribute__((unused))) {
+	static const uint8_t vht_ie[] = {
+		191, 12,                /* VHT Capabilities, length 12 */
+		0x36, 0x00, 0x80, 0x03, /* VHT Capabilities Info */
+		0xfa, 0xff, 0x00, 0x00, /* RX MCS map, highest rate */
+		0xfa, 0xff, 0x00, 0x00, /* TX MCS map, highest rate */
+	};
+	uint16_t len = sizeof(vht_ie);
+
+	buf[0] = AWDL_IEEE80211_CNTNR_TLV;
+	buf[1] = (uint8_t) (len & 0xff);
+	buf[2] = (uint8_t) (len >> 8);
+	memcpy(buf + 3, vht_ie, len);
+	return 3 + len;
+}
