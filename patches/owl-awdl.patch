+/* Local patch: after answering an ADDBA request, let the driver set up the
+ * hardware side of the session (a station entry and a firmware RX Block Ack),
+ * which mac80211 never does for AWDL's foreign BSSID. Runs ADDBA_HOOK with
+ * PEER TID SSN BUFSIZE, if it exists. */
+#define ADDBA_HOOK "/usr/lib/omdrop/awdl-ba-hook"
+static void awdl_addba_hook(const struct awdl_state *awdl) {
+	char peer[18], tid[4], ssn[8], size[8];
+	unsigned int buf_size = (awdl->addba.params >> 6) & 0x3ff;
+	pid_t pid;
+
+	if (access(ADDBA_HOOK, X_OK))
+		return;
+	if (buf_size == 0 || buf_size > 64)
+		buf_size = 64;
+	snprintf(peer, sizeof(peer), "%02x:%02x:%02x:%02x:%02x:%02x",
+	         awdl->addba.peer.ether_addr_octet[0], awdl->addba.peer.ether_addr_octet[1],
+	         awdl->addba.peer.ether_addr_octet[2], awdl->addba.peer.ether_addr_octet[3],
+	         awdl->addba.peer.ether_addr_octet[4], awdl->addba.peer.ether_addr_octet[5]);
+	snprintf(tid, sizeof(tid), "%u", (awdl->addba.params >> 2) & 0xf);
+	snprintf(ssn, sizeof(ssn), "%u", awdl->addba.ssn);
+	snprintf(size, sizeof(size), "%u", buf_size);
+	/* Waited for: a peer sends ADDBA requests back to back, and run side by
+	 * side their sessions were set up out of order, the later one with an
+	 * older starting sequence. The hook takes a few milliseconds. */
+	pid = fork();
+	if (pid == 0) {
+		execl(ADDBA_HOOK, ADDBA_HOOK, peer, tid, ssn, size, (char *) NULL);
+		_exit(127);
+	}
+	if (pid > 0)
+		waitpid(pid, NULL, 0);
+}
