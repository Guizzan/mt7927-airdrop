 DEFINE_DEBUGFS_ATTRIBUTE(fops_reset, NULL, mt7925_chip_reset, "%lld\n");
 
+/* echo "<mac> <tid> <ssn> <buf_size> [0]" > awdl_rx_ba (0 stops) */
+static ssize_t mt7925_awdl_rx_ba_write(struct file *file,
+				       const char __user *ubuf,
+				       size_t count, loff_t *ppos)
+{
+	struct mt792x_dev *dev = file->private_data;
+	unsigned int m[ETH_ALEN], tid, ssn, buf_size, on = 1;
+	u8 addr[ETH_ALEN];
+	char buf[64];
+	int i, ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	if (sscanf(buf, "%x:%x:%x:%x:%x:%x %u %u %u %u",
+		   &m[0], &m[1], &m[2], &m[3], &m[4], &m[5],
+		   &tid, &ssn, &buf_size, &on) < 9)
+		return -EINVAL;
+	if (tid >= IEEE80211_NUM_TIDS)
+		return -EINVAL;
+	for (i = 0; i < ETH_ALEN; i++)
+		addr[i] = m[i];
+
+	ret = mt7925_awdl_rx_ba(dev, addr, tid, ssn, buf_size, !!on);
+	return ret ? ret : count;
+}
+
+static const struct file_operations fops_awdl_rx_ba = {
+	.write = mt7925_awdl_rx_ba_write,
+	.open = simple_open,
+	.llseek = default_llseek,
+};
