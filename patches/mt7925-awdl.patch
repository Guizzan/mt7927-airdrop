 }
 
+struct mt7925_awdl_ba_iter {
+	const u8 *addr;
+	struct ieee80211_vif *vif;
+	struct ieee80211_sta *sta;
+};
+
+static void mt7925_awdl_ba_vif_iter(void *priv, u8 *mac,
+				    struct ieee80211_vif *vif)
+{
+	struct mt7925_awdl_ba_iter *it = priv;
+	struct ieee80211_sta *sta;
+
+	if (it->sta || vif->type != NL80211_IFTYPE_AP)
+		return;
+	sta = ieee80211_find_sta(vif, it->addr);
+	if (sta) {
+		it->vif = vif;
+		it->sta = sta;
+	}
+}
+
+/* Local patch (AWDL/AirDrop): start or stop a firmware RX Block Ack session
+ * for a station added to an AP vif. An AWDL peer's ADDBA request carries
+ * AWDL's BSSID, so mac80211 drops it and never calls ampdu_action; userspace
+ * (OWL) answers the request and asks for the session here, so the chip sends
+ * the hardware Block Ack an A-MPDU needs. */
+int mt7925_awdl_rx_ba(struct mt792x_dev *dev, const u8 *addr, u8 tid,
+		      u16 ssn, u16 buf_size, bool enable)
+{
+	struct ieee80211_hw *hw = mt76_hw(dev);
+	struct mt7925_awdl_ba_iter it = { .addr = addr };
+	struct ieee80211_ampdu_params params = {};
+	int ret;
+
+	rcu_read_lock();
+	ieee80211_iterate_active_interfaces_atomic(hw,
+		IEEE80211_IFACE_ITER_NORMAL, mt7925_awdl_ba_vif_iter, &it);
+	if (!it.sta) {
+		rcu_read_unlock();
+		return -ENOENT;
+	}
+	params.sta = it.sta;
+	params.tid = tid;
+	params.ssn = ssn;
+	params.buf_size = buf_size;
+	params.action = enable ? IEEE80211_AMPDU_RX_START :
+				 IEEE80211_AMPDU_RX_STOP;
+	rcu_read_unlock();
+
+	mt792x_mutex_acquire(dev);
+	{
+		struct mt792x_sta *msta = (struct mt792x_sta *)it.sta->drv_priv;
+
+		/* mt76's reorder buffer sits before mac80211, so monitors see
+		 * the peer's retried MPDUs back in order, as TCP needs. */
+		if (enable)
+			mt76_rx_aggr_start(&dev->mt76, &msta->deflink.wcid, tid,
+					   ssn, buf_size);
+		else
+			mt76_rx_aggr_stop(&dev->mt76, &msta->deflink.wcid, tid);
+	}
+	ret = mt7925_mcu_uni_rx_ba(dev, &params, it.vif, enable);
+	mt792x_mutex_release(dev);
+	dev_dbg(dev->mt76.dev, "awdl rx ba %pM tid %u ssn %u buf %u %s: %d\n",
+		 addr, tid, ssn, buf_size, enable ? "on" : "off", ret);
+	return ret;
+}
+
 static int
 mt7925_ampdu_action(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 		    struct ieee80211_ampdu_params *params)
