 	mt7925_mcu_set_sniffer(dev, vif, monitor);
+	/* MT7927: with the sniffer enabled on a vif that owns the channel (AP,
+	 * station), the sniffer is never told which channel to listen on, since
+	 * only a monitor-owned chanctx runs config_sniffer: monitors beside an AP
+	 * or station hear nothing. Configure it from that vif's chanctx. */
+	if (monitor && is_mt7927(&dev->mt76) &&
+	    vif->type != NL80211_IFTYPE_MONITOR && mvif->bss_conf.mt76.ctx) {
+		mt7925_mcu_config_sniffer(mvif, mvif->bss_conf.mt76.ctx);
