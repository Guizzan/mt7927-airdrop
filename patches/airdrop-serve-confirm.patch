+def confirm_transfer(ask, files, items):
+    """Show an Accept/Decline notification for an incoming Ask and wait for
+    the answer. No answer within CONFIRM_TIMEOUT, or no way to ask, declines."""
+    sender = ask.get('SenderComputerName') or 'Someone'
+    if files:
+        names = [f.get('FileName') or '?' for f in files]
+        size = sum(int(f.get('FileSize') or 0) for f in files)
+        what = ', '.join(names[:3]) + (f' and {len(names) - 3} more' if len(names) > 3 else '')
+        if size:
+            what += f' ({size / 1e6:.1f} MB)' if size >= 1e5 else f' ({size / 1e3:.0f} kB)'
+    elif items:
+        what = str(items[0])[:120]
+    else:
+        what = 'a file'
+    try:
+        r = subprocess.run(
+            ['notify-send', '--app-name=AirDrop', '--icon=folder-download',
+             '--urgency=critical', f'--expire-time={CONFIRM_TIMEOUT * 1000}',
+             '--action=accept=Accept', '--action=decline=Decline', '--wait',
+             f'AirDrop from {sender}', what],
+            capture_output=True, text=True, timeout=CONFIRM_TIMEOUT + 5)
+        answer = r.stdout.strip()
+    except (OSError, subprocess.SubprocessError) as e:
+        logging.warning('could not ask about the transfer (%r); declining', e)
+        return False
+    logging.info('confirmation for %s: %s', sender, answer or 'no answer')
+    return answer == 'accept'
+
