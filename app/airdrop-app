#!/usr/bin/env python3
"""AirDrop for Linux: a panel that drops down from the top bar. Pick files
(drop or choose), pick a nearby Apple device, send. A thin GTK front end over
the `omdrop` command line.

  airdrop-app [--toggle | --show | --hide] [--at X] [FILE...]

--at X centres the panel under screen x-coordinate X (the bar icon passes its
own position) and is remembered for later calls, such as a keybind's --toggle.
"""

import ctypes
import json
import os
import shutil
import sys

# gtk4-layer-shell has to be loaded before libwayland, i.e. before Gtk.
try:
    ctypes.CDLL("libgtk4-layer-shell.so.0")
except OSError:
    pass

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, GObject, Gtk  # noqa: E402

try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402
except (ValueError, ImportError):
    LayerShell = None

APP_ID = "io.github.guizzan.AirDrop"
OMDROP = shutil.which("omdrop") or os.path.expanduser("~/.local/bin/omdrop")
WINDOW_MINUTES = 30          # visibility window requested from omdrop
KEEPALIVE_S = 20 * 60        # renew it this often while visible
RESCAN_DELAY_S = 3           # pause between discovery rounds
PANEL_WIDTH = 420
PANEL_TOP = 68               # just below the ML4W bar island
COLORS = os.path.expanduser("~/.config/ml4w/colors/colors.json")
STATE = os.path.join(GLib.get_user_cache_dir(), "airdrop-app", "anchor")
LOG = os.path.join(GLib.get_user_cache_dir(), "airdrop-app", "log")


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write(f"{GLib.DateTime.new_now_local().format('%T')} {msg}\n")
    except OSError:
        pass


def tell_bar(state):
    """Keep the ML4W bar revealed while the panel is open (patch-airdrop.sh)."""
    qs = shutil.which("qs")
    if qs:
        try:
            run_quiet([qs, "ipc", "call", "airdropbar", state])
        except GLib.Error:
            pass


def human_size(n):
    for unit in ("B", "kB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000


def device_icon(name):
    n = (name or "").lower()
    if "iphone" in n:
        return "phone-symbolic"
    if "ipad" in n:
        return "tablet-symbolic"
    return "computer-symbolic"


def theme_css():
    """libadwaita colours and the bar's border, from the wallpaper palette."""
    c = {"background": "#141313", "surface_container": "#201f1f",
         "surface_container_high": "#2b2a2a", "primary": "#c8c6c5",
         "on_primary": "#111111", "on_surface": "#e5e2e1", "outline": "#929090"}
    try:
        with open(COLORS) as f:
            c.update(json.load(f))
    except (OSError, ValueError):
        pass
    g = c.get
    return f"""
@define-color window_bg_color {g('background')};
@define-color window_fg_color {g('on_surface')};
@define-color view_bg_color {g('background')};
@define-color view_fg_color {g('on_surface')};
@define-color card_bg_color {g('surface_container')};
@define-color card_fg_color {g('on_surface')};
@define-color accent_bg_color {g('primary')};
@define-color accent_fg_color {g('on_primary')};
@define-color accent_color {g('primary')};
@define-color popover_bg_color {g('surface_container')};
@define-color dialog_bg_color {g('surface_container')};
window.airdrop-panel {{ background: none; background-color: transparent; box-shadow: none; }}
.panel-border {{
  background: linear-gradient(to bottom, {g('primary')}, {g('on_primary')});
  border-radius: 14px; padding: 2px;
}}
.panel {{ background: {g('background')}; border-radius: 12px; }}
.panel-title {{ font-weight: bold; font-size: 1.05em; color: {g('primary')}; }}
.drop-zone {{ border: 2px dashed alpha({g('primary')}, 0.35); border-radius: 12px;
              background: alpha({g('surface_container')}, 0.6); }}
.drop-zone.dropping {{ border-color: {g('primary')}; background: alpha({g('primary')}, 0.15); }}
.drop-zone image {{ color: {g('primary')}; }}
"""


def read_anchor():
    try:
        with open(STATE) as f:
            return int(float(f.read().strip()))
    except (OSError, ValueError):
        return None


def write_anchor(x):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, "w") as f:
            f.write(f"{x}\n")
    except OSError:
        pass


class LineReader:
    """Run a command, call on_line(str) per output line and on_exit(ok) at the end."""

    def __init__(self, argv, on_line, on_exit):
        self.on_line, self.on_exit = on_line, on_exit
        self.proc = Gio.Subprocess.new(
            argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        self.stream = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self.cancel = Gio.Cancellable()
        self._read()

    def _read(self):
        self.stream.read_line_async(GLib.PRIORITY_DEFAULT, self.cancel, self._got)

    def _got(self, stream, res):
        try:
            line, _ = stream.read_line_finish_utf8(res)
        except GLib.Error:
            line = None
        if line is None:
            self.proc.wait_async(None, self._exited)
            return
        self.on_line(line)
        self._read()

    def _exited(self, proc, res):
        try:
            proc.wait_finish(res)
        except GLib.Error:
            pass
        self.on_exit(proc.get_if_exited() and proc.get_exit_status() == 0)

    def stop(self):
        self.on_exit = lambda ok: None
        self.cancel.cancel()
        self.proc.force_exit()


def run_quiet(argv, done=None):
    p = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
    if done:
        p.wait_async(None, lambda pr, res: (pr.wait_finish(res), done()))
    return p


class AirDropPanel(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="AirDrop", resizable=False)
        self.add_css_class("airdrop-panel")
        # The panel draws its own card; a themed .background (glass themes make
        # it translucent) would tint the transparent margin around it.
        self.remove_css_class("background")
        self.set_default_size(PANEL_WIDTH, -1)
        self.files = []            # Gio.File
        self.devices = {}          # name -> Adw.ActionRow
        self.selected = None       # device name
        self.scanner = None
        self.sender = None
        self.scan_source = 0
        self.keepalive_source = 0
        self.pulse = 0
        self._setting = False

        self.layered = bool(LayerShell and LayerShell.is_supported())
        if self.layered:
            LayerShell.init_for_window(self)
            LayerShell.set_namespace(self, "airdrop")
            LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
            LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
            LayerShell.set_anchor(self, LayerShell.Edge.LEFT, True)
            LayerShell.set_exclusive_zone(self, -1)
            LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.ON_DEMAND)
            LayerShell.set_margin(self, LayerShell.Edge.TOP, PANEL_TOP)
        self.anchor_x = read_anchor()
        self.place(self.anchor_x)
        self.connect("map", lambda *_: self.place(self.anchor_x))

        border = Gtk.Box(css_classes=["panel-border"], margin_top=4, margin_bottom=16,
                         margin_start=16, margin_end=16)
        self.toasts = Adw.ToastOverlay()
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                        css_classes=["panel"], hexpand=True)
        self.toasts.set_child(panel)
        border.append(self.toasts)
        self.set_child(border)

        # Title row
        top = Gtk.Box(spacing=8, margin_top=12, margin_start=16, margin_end=10)
        top.append(Gtk.Image(icon_name="network-wireless-symbolic", css_classes=["panel-title"]))
        top.append(Gtk.Label(label="AirDrop", css_classes=["panel-title"], hexpand=True, xalign=0))
        top.append(Gtk.Label(label="Visible", css_classes=["dim-label"]))
        self.visible_switch = Gtk.Switch(valign=Gtk.Align.CENTER,
                                         tooltip_text="Let nearby Apple devices see and send to this PC")
        self.visible_switch.connect("notify::active", self.on_visible_toggled)
        top.append(self.visible_switch)
        close = Gtk.Button(icon_name="window-close-symbolic", css_classes=["flat", "circular"],
                           valign=Gtk.Align.CENTER, tooltip_text="Close (Esc)")
        close.connect("clicked", lambda *_: self.hide_panel())
        top.append(close)
        panel.append(top)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                       margin_start=16, margin_end=16)
        panel.append(body)

        # Files: drop zone + chooser + list
        self.drop_zone = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                                 css_classes=["drop-zone"])
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                        valign=Gtk.Align.CENTER, margin_top=14, margin_bottom=14)
        inner.append(Gtk.Image(icon_name="folder-download-symbolic", pixel_size=36))
        inner.append(Gtk.Label(label="Drop files here"))
        choose = Gtk.Button(label="Choose Files…", halign=Gtk.Align.CENTER, css_classes=["pill"])
        choose.connect("clicked", self.on_choose)
        inner.append(choose)
        self.drop_zone.append(inner)
        body.append(self.drop_zone)

        self.files_group = Adw.PreferencesGroup(title="Files")
        self.files_group.set_visible(False)
        clear = Gtk.Button(icon_name="edit-clear-all-symbolic", tooltip_text="Clear files",
                           css_classes=["flat"], valign=Gtk.Align.CENTER)
        clear.connect("clicked", lambda *_: self.set_files([]))
        self.files_group.set_header_suffix(clear)
        self.file_rows = []
        self.files_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                               propagate_natural_height=True, max_content_height=200,
                                               visible=False)
        self.files_scroll.set_child(self.files_group)
        body.append(self.files_scroll)

        # Devices
        self.dev_group = Adw.PreferencesGroup(
            title="Nearby Devices",
            description="Set AirDrop to “Everyone for 10 Minutes” on the other device.")
        self.scan_spinner = Adw.Spinner()
        self.dev_group.set_header_suffix(self.scan_spinner)
        self.empty_row = Adw.ActionRow(title="Looking for devices…",
                                       subtitle="Unlock the device and keep it nearby")
        self.empty_row.add_css_class("dim-label")
        self.dev_group.add(self.empty_row)
        body.append(self.dev_group)
        self.radio_group = None    # Gtk.CheckButton group leader

        # Send bar
        bottom = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                         margin_bottom=14, margin_start=16, margin_end=16)
        self.status = Gtk.Label(xalign=0, wrap=True, css_classes=["dim-label"])
        self.progress = Gtk.ProgressBar(visible=False)
        self.send_button = Gtk.Button(label="Send", css_classes=["suggested-action", "pill"],
                                      sensitive=False, halign=Gtk.Align.CENTER)
        self.send_button.set_size_request(200, -1)
        self.send_button.connect("clicked", self.on_send)
        bottom.append(self.progress)
        bottom.append(self.status)
        bottom.append(self.send_button)
        panel.append(bottom)

        # Drops anywhere on the panel count, not only on the zone. File lists,
        # or plain text/uri-list for sources that only offer that.
        drop = Gtk.DropTarget.new(GObject.TYPE_NONE, Gdk.DragAction.COPY | Gdk.DragAction.MOVE)
        drop.set_gtypes([Gdk.FileList.__gtype__, GObject.TYPE_STRING])
        drop.set_preload(True)
        drop.connect("drop", self.on_drop)
        drop.connect("enter", self.on_drag_enter)
        drop.connect("leave", lambda *_: self.drop_zone.remove_css_class("dropping"))
        panel.add_controller(drop)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("close-request", self.on_close_request)
        self.update_send_button()

    # ----------------------------------------------------------- placement
    def place(self, x):
        if not self.layered:
            return
        self.anchor_x = x
        width = None
        surface = self.get_surface()
        display = Gdk.Display.get_default()
        mon = display.get_monitor_at_surface(surface) if display and surface else None
        if mon is None and display and display.get_monitors().get_n_items():
            mon = display.get_monitors().get_item(0)
        if mon is not None:
            width = mon.get_geometry().width
        if x is None:
            if width is None:
                return            # placed again once mapped
            x = width - 540       # roughly where the bar's right-hand icons sit
        left = int(x) - PANEL_WIDTH // 2 - 16
        if width is not None:
            left = min(left, width - PANEL_WIDTH - 40)
        LayerShell.set_margin(self, LayerShell.Edge.LEFT, max(8, left))

    def show_panel(self):
        was_visible = self.get_visible()
        self.present()
        tell_bar("opened")
        if not was_visible:
            self.refresh_visibility()
            self.start_scan()

    def hide_panel(self):
        self.stop_scan()
        self.set_visible(False)
        tell_bar("closed")

    def toggle(self):
        if self.get_visible():
            self.hide_panel()
        else:
            self.show_panel()

    def on_key(self, _ctl, keyval, _code, state):
        if keyval == Gdk.KEY_Escape:
            self.hide_panel()
            return True
        if keyval in (Gdk.KEY_q, Gdk.KEY_Q) and state & Gdk.ModifierType.CONTROL_MASK:
            self.get_application().quit()
            return True
        return False

    def on_close_request(self, *_):
        self.hide_panel()
        return True               # keep running: the next toggle is instant

    # ---------------------------------------------------------------- files
    def set_files(self, files):
        seen, out = set(), []
        for f in files:
            p = f.get_path()
            if p and p not in seen and os.path.isfile(p):
                seen.add(p)
                out.append(f)
        self.files = out
        for row in self.file_rows:
            self.files_group.remove(row)
        self.file_rows = []
        for f in self.files:
            p = f.get_path()
            row = Adw.ActionRow(title=GLib.markup_escape_text(os.path.basename(p)),
                                subtitle=human_size(os.path.getsize(p)))
            row.add_prefix(Gtk.Image(icon_name="text-x-generic-symbolic"))
            rm = Gtk.Button(icon_name="window-close-symbolic", css_classes=["flat", "circular"],
                            valign=Gtk.Align.CENTER, tooltip_text="Remove")
            rm.connect("clicked", lambda _b, ff=f: self.set_files([x for x in self.files if x is not ff]))
            row.add_suffix(rm)
            self.files_group.add(row)
            self.file_rows.append(row)
        self.files_group.set_visible(bool(self.files))
        self.files_scroll.set_visible(bool(self.files))
        self.update_send_button()

    def add_files(self, files):
        self.set_files(self.files + list(files))

    def on_choose(self, _btn):
        # No parent: the portal can't export a layer-shell surface as a dialog
        # parent, and trying makes the compositor drop the connection.
        dialog = Gtk.FileDialog(title="Choose files to send")
        dialog.open_multiple(None, None, self._chosen)
        log("file chooser opened")

    def _chosen(self, dialog, res):
        try:
            model = dialog.open_multiple_finish(res)
        except GLib.Error as e:
            log(f"file chooser: {e.message}")
            return
        files = [model.get_item(i) for i in range(model.get_n_items())]
        log(f"file chooser: {len(files)} file(s)")
        self.add_files(files)
        self.present()

    def on_drag_enter(self, target, _x, _y):
        drop = target.get_current_drop()
        formats = drop.get_formats().to_string() if drop else "?"
        log(f"drag enter, formats {formats}")
        self.drop_zone.add_css_class("dropping")
        return Gdk.DragAction.COPY

    def on_drop(self, _target, value, _x, _y):
        self.drop_zone.remove_css_class("dropping")
        try:
            if isinstance(value, Gdk.FileList):
                files = value.get_files()
            elif isinstance(value, str):
                files = [Gio.File.new_for_uri(u.strip()) for u in value.splitlines()
                         if u.strip().startswith("file://")]
            else:
                log(f"drop: unexpected value {type(value).__name__}")
                return False
            log(f"drop: {len(files)} file(s)")
            self.add_files(files)
            return bool(files)
        except Exception as e:  # noqa: BLE001 - a failed drop must not kill the panel
            log(f"drop failed: {e!r}")
            return False

    # -------------------------------------------------------------- devices
    def start_scan(self):
        self.scan_source = 0
        if self.scanner or self.sender or not self.get_visible():
            return False
        self.scan_spinner.set_visible(True)
        try:
            self.scanner = LineReader([OMDROP, "peers", "--json", "-n", "--stream"],
                                      self.on_peer_line, self.on_scan_done)
        except GLib.Error as e:
            self.set_status(f"Could not look for devices: {e.message}")
            self.scanner = None
        return False

    def on_peer_line(self, line):
        try:
            peer = json.loads(line)
        except ValueError:
            return
        name = peer.get("name")
        if not name or name in self.devices:
            return
        row = Adw.ActionRow(title=GLib.markup_escape_text(name), activatable=True)
        check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
        if self.radio_group:
            check.set_group(self.radio_group)
        else:
            self.radio_group = check
        check.connect("toggled", self.on_device_toggled, name)
        row.add_prefix(check)
        row.add_suffix(Gtk.Image(icon_name=device_icon(name), css_classes=["dim-label"]))
        row.set_activatable_widget(check)
        self.devices[name] = row
        if self.empty_row.get_parent():
            self.dev_group.remove(self.empty_row)
        self.dev_group.add(row)
        if len(self.devices) == 1:
            check.set_active(True)

    def on_scan_done(self, _ok):
        self.scanner = None
        self.scan_spinner.set_visible(False)
        if not self.sender and self.get_visible() and not self.scan_source:
            self.scan_source = GLib.timeout_add_seconds(RESCAN_DELAY_S, self.start_scan)

    def stop_scan(self):
        if self.scan_source:
            GLib.source_remove(self.scan_source)
            self.scan_source = 0
        if self.scanner:
            self.scanner.stop()
            self.scanner = None
            self.scan_spinner.set_visible(False)

    def on_device_toggled(self, check, name):
        if check.get_active():
            self.selected = name
        elif self.selected == name:
            self.selected = None
        self.update_send_button()

    # ----------------------------------------------------------------- send
    def update_send_button(self):
        ready = bool(self.files) and bool(self.selected) and not self.sender
        self.send_button.set_sensitive(ready)
        if not self.sender:
            if not self.files:
                self.set_status("Add files to send.")
            elif not self.selected:
                self.set_status("Choose who to send to.")
            else:
                n = len(self.files)
                self.set_status(f"Ready to send {n} file{'s' if n > 1 else ''} to {self.selected}.")

    def set_status(self, text):
        self.status.set_label(text)

    def on_send(self, _btn):
        if not (self.files and self.selected):
            return
        self.stop_scan()
        self.send_button.set_sensitive(False)
        self.progress.set_visible(True)
        self.pulse = GLib.timeout_add(120, lambda: (self.progress.pulse(), True)[1])
        self.send_target = self.selected
        files = [f.get_path() for f in self.files]
        self.set_status(f"Looking for {self.send_target}…")
        if not self.visible_switch.get_active():
            # Sending needs the radio, which only runs while visible.
            self.visible_switch.set_active(True)
        self.send_lines = []
        self.sender = LineReader([OMDROP, "send", self.send_target, *files],
                                 self.on_send_line, self.on_send_done)

    def on_send_line(self, line):
        line = line.strip()
        if not line:
            return
        self.send_lines.append(line)
        if line.startswith("sending ") or line.startswith("waiting up to"):
            return
        if line.startswith("Asking them"):
            line = f"Waiting for {self.send_target} to accept…"
        elif line.startswith("They accepted"):
            line = "Accepted. Sending…"
        self.set_status(line)

    def on_send_done(self, ok):
        if self.pulse:
            GLib.source_remove(self.pulse)
            self.pulse = 0
        self.progress.set_visible(False)
        self.sender = None
        last = self.send_lines[-1] if self.send_lines else ""
        if ok and last.startswith("Sent"):
            self.toasts.add_toast(Adw.Toast(title=f"Sent to {self.send_target}", timeout=4))
            self.set_files([])
        else:
            text = last or "Sending failed."
            if "declin" in text.lower():
                text = f"{self.send_target} declined."
            self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text[:120]), timeout=6))
            self.set_status(text)
        self.update_send_button()
        self.start_scan()

    # ----------------------------------------------------------- visibility
    def refresh_visibility(self):
        try:
            out = GLib.spawn_command_line_sync(f"{OMDROP} status")[1].decode()
        except GLib.Error:
            out = ""
        on = out.startswith("Visible")
        self._setting = True
        self.visible_switch.set_active(on)
        self._setting = False
        if not on:
            # Opening AirDrop turns it on, as it does on a Mac.
            self.visible_switch.set_active(True)
        else:
            self.start_keepalive()

    def on_visible_toggled(self, sw, _pspec):
        if self._setting:
            return
        if sw.get_active():
            run_quiet([OMDROP, "on", f"{WINDOW_MINUTES}m"], self._on_ready)
            self.start_keepalive()
        else:
            if self.keepalive_source:
                GLib.source_remove(self.keepalive_source)
                self.keepalive_source = 0
            run_quiet([OMDROP, "off"])

    def _on_ready(self):
        if not self.scanner and not self.sender:
            self.start_scan()

    def start_keepalive(self):
        if not self.keepalive_source:
            self.keepalive_source = GLib.timeout_add_seconds(KEEPALIVE_S, self._keepalive)

    def _keepalive(self):
        if self.visible_switch.get_active():
            run_quiet([OMDROP, "on", f"{WINDOW_MINUTES}m"])
            return True
        self.keepalive_source = 0
        return False


class AirDropApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.css = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        self.css = Gtk.CssProvider()
        self.load_css()
        # Above the user's gtk.css too: the panel's look is self-contained.
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        # Follow wallpaper colour changes.
        self._colors_monitor = Gio.File.new_for_path(COLORS).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self._colors_monitor.connect("changed", lambda *_: self.load_css())
        self.hold()               # stay resident while hidden

    def load_css(self):
        self.css.load_from_string(theme_css())

    def do_shutdown(self):
        tell_bar("closed")
        Adw.Application.do_shutdown(self)

    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        action, files, i = "show", [], 0
        while i < len(args):
            a = args[i]
            if a in ("--toggle", "--show", "--hide"):
                action = a[2:]
            elif a == "--at" and i + 1 < len(args):
                i += 1
                try:
                    x = int(float(args[i]))
                    write_anchor(x)
                    if self.win:
                        self.win.place(x)
                except ValueError:
                    pass
            elif a == "--quit":
                self.quit()
                return 0
            else:
                files.append(cmd.create_file_for_arg(a))
            i += 1
        if not self.win:
            self.win = AirDropPanel(self)
        if files:
            self.win.add_files(files)
            action = "show"
        if action == "toggle":
            self.win.toggle()
        elif action == "hide":
            self.win.hide_panel()
        else:
            self.win.show_panel()
        return 0


if __name__ == "__main__":
    # Launched detached from the bar: keep GTK's and Python's messages.
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        os.dup2(fd, 2)
    except OSError:
        pass
    sys.exit(AirDropApp().run(sys.argv))
